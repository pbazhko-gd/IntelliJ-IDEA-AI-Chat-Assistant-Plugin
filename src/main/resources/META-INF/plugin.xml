<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.pbazhko.ai-chat-plugin</id>
    <name>AI Chat Assistant</name>
    <vendor email="pbazhko@griddynamics.com" url="https://griddynamics.com">Pavel Bazhko</vendor>
    <description><![CDATA[
        <p><b>IntelliJ IDEA AI Chat Assistant</b></p>
        <p>An IntelliJ IDEA plugin that provides direct access to an AI-powered chat assistant directly inside the IDE. Developers can use the chat to ask questions, get coding assistance, explain code, generate ideas, and improve their development workflow without leaving IntelliJ IDEA.</p>
        <p>This plugin is developed as part of the GridU course "IntelliJ IDEA Plugin Development" and demonstrates how to integrate an AI chat experience into an IntelliJ IDEA plugin.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="AI Chat"
                    anchor="right"
                    icon="AllIcons.Actions.Refresh"
                    factoryClass="com.griddynamics.pbazhko.plugin.ui.AIChatToolWindowFactory"/>
        <applicationService
                serviceImplementation="com.griddynamics.pbazhko.plugin.state.AppSettingsState"/>
        <applicationConfigurable
                parentId="tools"
                id="com.griddynamics.pbazhko.plugin.settings.AppSettingsConfigurable"
                instance="com.griddynamics.pbazhko.plugin.settings.AppSettingsConfigurable"
                displayName="AI Chat Settings"/>
    </extensions>

    <actions>
        <action id="com.griddynamics.pbazhko.plugin.action.AskAIContextAction"
                class="com.griddynamics.pbazhko.plugin.action.AskAIContextAction"
                text="Ask AI About Selection"
                description="Send the selected text to the AI Chat Panel">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
